# Review of the municipal services' addresses, every three months (owner, 2026-10-27): reopens each
# address's source page and emails falcon@ which ones are gone, unreachable or due
# (bin/greece/departments-review). Runs on the fms VM, so it moves with it.
# Install: sudo install -m 644 conf/greece/cron.d/fixmystreets-departments-review /etc/cron.d/
SHELL=/bin/sh
0 9 1 1,4,7,10 * debian /opt/fixmystreet/bin/greece/departments-review >> /var/log/fixmystreets/departments-review.log 2>&1

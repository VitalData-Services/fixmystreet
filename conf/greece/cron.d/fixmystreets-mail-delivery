# FixMyStreets: whether each report's email reached the service (bin/greece/mail-delivery): every hour
# it reads our relay's log (freevium1) and stores ✓/⚠ on the reports; at 08:05 and 20:05 it also reads
# the bounces@fixmystreets.gr mailbox (infra9) and sends falcon@ the list. New failures go to falcon@.
# Runs on the fms VM; the relay and the mailbox host are reached with ~/.ssh/fms-mail of user debian.
# Install: sudo install -m 644 conf/greece/cron.d/fixmystreets-mail-delivery /etc/cron.d/
SHELL=/bin/sh
20 * * * * debian /opt/fixmystreet/bin/greece/mail-delivery >> /var/log/fixmystreets/mail-delivery.log 2>&1
5 8,20 * * * debian /opt/fixmystreet/bin/greece/mail-delivery --mailbox >> /var/log/fixmystreets/mail-delivery.log 2>&1

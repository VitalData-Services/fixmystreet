# An example configuration for running FixMyStreet under nginx.  You
# will also need to set up the FixMyStreet Catalyst FastCGI backend.
# An example sysvinit script to help with this is shown given in the file
# sysvinit-catalyst-fastcgi.example in this directory.
#
# See our installation help at https://fixmystreet.org/

# Address suggestions while typing (/places, web/cobrands/greece/place-search.js) come from
# Photon, which allows search-as-you-type; Nominatim's usage policy does not. Only the query is
# passed on, without the visitor's headers, cookies or address. Behind the Cloudflare tunnel every
# request comes from the tunnel, so the rate limit is per visitor address in CF-Connecting-IP.
proxy_cache_path /var/cache/nginx/places levels=1:2 keys_zone=places:5m max_size=50m inactive=7d;
limit_req_zone $http_cf_connecting_ip zone=places_rate:5m rate=5r/s;
# Municipality outlines (location /mapit/ below): kept for 30 days, so global MapIt sees each once.
proxy_cache_path /var/cache/nginx/mapit levels=1:2 keys_zone=mapit:2m max_size=100m inactive=30d;
limit_req_zone $visitor zone=mapit_rate:5m rate=5r/s;

# Reports need no account or email confirmation, so submissions are limited per visitor: POSTs
# that create a report or an update, or send an email to an address typed into a form (sign-in,
# password reset, alerts, contact), share one budget of 6 at once, then one every 30 seconds.
# Anything else gets an empty key, which nginx does not count. A request that did not come
# through Cloudflare counts by its own address.
map $http_cf_connecting_ip $visitor {
    ""      $remote_addr;
    default $http_cf_connecting_ip;
}
map "$request_method $uri" $form_post_visitor {
    default "";
    "~*^POST /(report/new(/mobile)?|import|report/update|auth(/create|/forgot|/ajax/sign_in)?|alert/subscribe|contact/submit|greece/auth)/?$" $visitor;
}
limit_req_zone $form_post_visitor zone=form_posts:5m rate=2r/m;

# 👍/👎 votes (POST /greece/vote/<id>), their own budget per visitor: 10 at once, then 20 a minute.
map "$request_method $uri" $vote_visitor {
    default "";
    "~^POST /greece/vote/" $visitor;
}
limit_req_zone $vote_visitor zone=votes:5m rate=20r/m;

# Static files (location below): the ones the pages link with a version (?<digest of the file>, which
# changes with the file) are kept by browsers for a year; any other for a day. Catalyst sends only
# "public", so browsers asked again on every visit.
map $args $static_cache_control {
    ""      "public, max-age=86400";
    default "public, max-age=31536000, immutable";
}

server {

    listen 80 default_server;
    root /var/www/fixmystreet/fixmystreet/web;
    error_page 503 /down.html;

    # Make sure that Javascript and CSS are compressed.  (HTML is
    # already compressed under the default configuration of the nginx
    # package.)

    gzip on;
    gzip_disable "msie6";
    gzip_types application/javascript application/x-javascript text/css;

    client_max_body_size 10m;

    # These rewrite rules are ported from the Apache configuration in
    # conf/httpd.conf

    rewrite ^/rss/council/([0-9]+)$  /rss/reports/$1 permanent;
    rewrite ^/report$                /reports        permanent;
    rewrite '^/{/rss/(.*)}$'         /rss/$1         permanent;
    rewrite '^/reports/{/rss/(.*)}$' /rss/$1         permanent;
    rewrite ^/alerts/?$              /alert          permanent;
    # A report's address is its number, /report/20261026-03 (Greece.pm greece_ref); FixMyStreet's
    # /report/<id> takes digits only, so the number goes to the Greece controller that shows it.
    rewrite '^/report/(\d{8}-\d+)/?$' /greece/report-ref/$1 last;

    # The map's only MapIt call from the browser, a municipality's outline on /reports/<Δήμος>, goes to
    # the local MapIt service, which gets it from global MapIt; nginx keeps it (proxy_cache mapit), so
    # visitors cannot run up calls to the MapIt the site depends on. Nothing else is passed on. It
    # used to go to the UK MapIt, as //area/..., and got 404/503, so no outline was drawn.
    location ~ ^/mapit/area/[0-9]+\.geojson$ {
        limit_req zone=mapit_rate burst=10 nodelay;
        limit_req_status 429;
        # FixMyStreet's own query only, whatever is asked, so one copy per municipality.
        rewrite ^/mapit/(area/[0-9]+\.geojson)$ /$1?simplify_tolerance=0.0001? break;
        proxy_pass http://mapit-local.svc:8080;
        proxy_cache mapit;
        proxy_cache_key $uri;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache $upstream_cache_status;
    }
    location /mapit/ {
        return 404;
    }

    location = /places {
        limit_req zone=places_rate burst=10 nodelay;
        resolver 127.0.0.11 valid=300s ipv6=off;
        set $photon photon.komoot.io;
        proxy_pass https://$photon/api/?q=$arg_q&limit=10&bbox=19.2,34.7,29.8,41.8;
        proxy_ssl_server_name on;
        proxy_pass_request_headers off;
        proxy_set_header Host photon.komoot.io;
        proxy_set_header User-Agent "FixMyStreets Greece (+https://fixmystreets.gr)";
        proxy_set_header Accept application/json;
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_cache places;
        proxy_cache_key $arg_q;
        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, max-age=3600";
    }

    # Self-hosted map tiles and style (tiles compose service).
    location /tiles/ {
        proxy_pass http://tiles.svc:8080/;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=86400";
    }

    location ~ ^/(cobrands|vendor|js|theme|i)/ {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_redirect off;
        proxy_pass http://fixmystreet.svc:9000;
        proxy_hide_header Cache-Control;
        add_header Cache-Control $static_cache_control;
    }

    location / {
        if (-f $document_root/down.html) {
            return 503;
        }
        try_files $uri @catalyst;
    }

    location /down.html {
        internal;
    }

    location @too_many {
        default_type "text/html; charset=utf-8";
        add_header Retry-After 60 always;
        return 429 '<!doctype html><html lang="el"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Πολλές υποβολές</title><style>body{font-family:system-ui,sans-serif;max-width:36em;margin:3em auto;padding:0 16px;line-height:1.5;color:#0c1b33;background:#f3f5fa}</style></head><body><h1>Πολλές υποβολές σε λίγο χρόνο</h1><p>Από τη σύνδεσή σου στάλθηκαν πολλές φόρμες μέσα σε λίγα λεπτά. Περίμενε ένα λεπτό, γύρνα πίσω με το κουμπί «Πίσω» του φυλλομετρητή και στείλε ξανά τη φόρμα.</p><p><a href="/">Αρχική σελίδα</a></p></body></html>';
    }

    location @catalyst {
        limit_req zone=form_posts burst=5 nodelay;
        limit_req zone=votes burst=10 nodelay;
        limit_req_status 429;
        error_page 429 @too_many;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_redirect off;
        proxy_pass http://fixmystreet.svc:9000;
    }
}
